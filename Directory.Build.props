<Project>
  <!-- Import shared build standards -->
  <Import Project="build-standards/Directory.Build.props.shared" />

  <PropertyGroup>
    <!-- TargetFramework(s) set in subdirectory Directory.Build.props files -->

    <!-- Override shared ImplicitUsings (this repo uses explicit usings) -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Common assembly information -->
    <Company>Universities of Dundee and Edinburgh</Company>
    <Product>DicomTypeTranslation</Product>
    <Copyright>Copyright © 2020-2025</Copyright>
    <Version>5.0.1</Version>
    <AssemblyVersion>5.0.1</AssemblyVersion>
    <FileVersion>5.0.1</FileVersion>
    <InformationalVersion>5.0.1</InformationalVersion>

    <!-- Enable Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Suppress analyzer warnings from shared config that need gradual adoption -->
    <!-- These can be removed incrementally as the code is improved -->
    <NoWarn>$(NoWarn);CA1018;CA1051;CA1062;CA1069;CA1304;CA1305;CA1309;CA1311;CA1707;CA1711;CA1805;CA1822;CA1852;CA1859;CA1860;CA1861;CA1865;CA2201;CA2211</NoWarn>
  </PropertyGroup>

  <!-- Release configuration settings -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
