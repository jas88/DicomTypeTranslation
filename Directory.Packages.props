<Project>
  <!-- Central Package Management -->
  <!-- Package versions are defined here and referenced in project files without Version attributes -->

  <ItemGroup>
    <!-- Main dependencies -->
    <PackageVersion Include="fo-dicom" Version="5.2.5" />
    <PackageVersion Include="FAnsiSql.Legacy" Version="3.6.3" />
    <PackageVersion Include="MongoDB.Bson" Version="3.5.2" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />

    <!-- Build tools (referenced from build-standards/Directory.Build.props.shared) -->
    <PackageVersion Include="MinVer" Version="6.0.0" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="1.2.39" />

    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="NUnit" Version="4.4.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.11.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
